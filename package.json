{
  "name": "dsh-task-lens",
  "version": "0.1.0",
  "description": "A model-driven task plan, live progress, and isolated read-only question window for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lester076/dsh-task-lens.git"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "external": [
        "react",
        "react/jsx-runtime",
        "@deepseek-ai/cordis",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-brand": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-scope": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-util-values": "^0.1.5-alpha.1",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@tsdown/css": "^0.23.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.6"
  },
  "dependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.0.0-rc.11"
  }
}
